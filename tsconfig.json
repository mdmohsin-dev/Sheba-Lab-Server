{
  "compilerOptions": {
    /* Language */
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    /* Modules */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Project Structure */
    "rootDir": "./src",
    "outDir": "./dist",
    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    /* Types */
    "types": [
      "node"
    ],
    /* Output */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    /* Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    /* Module */
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    /* Misc */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    /* TS */
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*",
    "prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "prisma.config.ts"
  ]
}